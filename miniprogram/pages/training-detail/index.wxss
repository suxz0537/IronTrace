.training-detail-page {
  min-height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
}

.page-header {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.nav-right {
  padding: 0 12rpx;
}

.nav-right-text {
  color: #1989fa;
  font-size: 28rpx;
  font-weight: 500;
}

.session-summary {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 16rpx 28rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-label {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
}

.summary-value-accent {
  color: #1989fa;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: #ebedf0;
}

.page-content {
  flex: 1;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.exercise-card-wrap {
  margin: 0 16rpx 16rpx;
}

.exercise-card {
  border-radius: 16rpx !important;
  overflow: hidden;
}

.exercise-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.set-list {
  margin-top: 8rpx;
}

.set-swipe-cell {
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.set-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 16rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.warmup-bg {
  background: #fffbe8;
}

.set-no-col {
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 18rpx;
  flex-shrink: 0;
}

.set-no-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #1989fa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-no-circle.warmup {
  background: #ff976a;
}

.set-no-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.set-input-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 8rpx;
}

.input-label {
  font-size: 22rpx;
  color: #969799;
  margin-bottom: 8rpx;
}

.set-stepper {
  --van-stepper-button-round-theme-color: #1989fa;
}

.set-extra-col {
  flex: 1.4;
  display: flex;
  flex-direction: column;
  padding-left: 8rpx;
  flex-shrink: 0;
}

.extra-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.extra-item {
  display: flex;
  align-items: center;
}

.rpe-item {
  margin-left: 16rpx;
}

.extra-label {
  font-size: 22rpx;
  color: #969799;
  margin-right: 8rpx;
}

.rpe-stepper {
  --van-stepper-input-width: 56rpx;
  --van-stepper-button-round-theme-color: #07c160;
}

.rpe-stepper :deep(.van-stepper__input) {
  width: 56rpx !important;
}

.volume-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 4rpx;
}

.volume-text {
  font-size: 22rpx;
  color: #1989fa;
  font-weight: 500;
}

.swipe-action {
  height: 100%;
}

.delete-btn {
  width: 120rpx;
  height: 100%;
  background: #ee0a24;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.add-set-btn {
  margin-top: 8rpx;
  border-radius: 10rpx !important;
}

.empty-state {
  margin-top: 160rpx;
}

.content-bottom-space {
  height: 280rpx;
}

.submit-bar {
  position: sticky;
  bottom: 0;
}

.note-input-wrap {
  flex: 1;
  margin-right: 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 4rpx 0;
  box-sizing: border-box;
  max-height: 180rpx;
  overflow: hidden;
}

.note-input {
  width: 100%;
}

.note-input :deep(.van-field__control) {
  font-size: 26rpx !important;
  line-height: 1.5 !important;
}
