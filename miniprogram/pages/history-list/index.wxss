.history-list-page {
  min-height: 100vh;
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
}

.page-header {
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.page-content {
  flex: 1;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.list-item-wrap {
  margin: 0 16rpx 16rpx;
}

.session-swipe-cell {
  border-radius: 16rpx;
  overflow: hidden;
}

.session-card-clickable {
  border-radius: 16rpx;
  overflow: hidden;
}

.session-card {
  border-radius: 16rpx !important;
  overflow: hidden;
}

.session-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.session-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #ebedf0;
}

.meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 22rpx;
  color: #969799;
  margin-bottom: 6rpx;
}

.meta-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #323233;
}

.meta-value-accent {
  color: #1989fa;
}

.meta-divider {
  width: 1rpx;
  height: 48rpx;
  background: #ebedf0;
}

.swipe-action {
  height: 100%;
}

.delete-btn {
  width: 140rpx;
  height: 100%;
  background: #ee0a24;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
}

.empty-state {
  margin-top: 200rpx;
}

.content-bottom-space {
  height: 60rpx;
}
